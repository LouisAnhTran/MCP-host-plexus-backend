# Postgres. Local dev runs pgvector in Docker on host port 5433 via
# docker-compose.db.yml — 5432 is left to a native/Homebrew install.
#   docker compose -f ../docker-compose.db.yml up -d
DATABASE_URL=postgresql://postgres:plexus-local@localhost:5433/plexus

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── MCP servers ──────────────────────────────────────────────────────────────
# One URL per supported MCP server. These are the addresses the host dials when
# a server is wired; the set of *supported* servers is declared in
# services/mcp_registry.py.
#
#   host on the machine, MCP server in Docker   http://localhost:9000/mcp
#   both in the same compose project            http://einvoice-mcp:9000/mcp
#   both in Kubernetes                          http://einvoice-mcp:9000/mcp
MCP_EINVOICE_URL=http://localhost:9000/mcp
